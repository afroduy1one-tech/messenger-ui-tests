    {
      "name": "Отклонение сообщения длиной более 1000 символов",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              ""
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"longText\", \"a\".repeat(1001));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"recipient\": \"masha\",\n    \"text\": \"{{longText}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
